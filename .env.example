# ==============================================================================
# Witcher 3 RAG: Пример конфигурации окружения (.env)
# Скопируйте этот файл в .env и укажите ваши параметры:
# cp .env.example .env
# ==============================================================================

# --- Параметры Milvus Vector DB ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TOKEN=root:Milvus
COLLECTION_NAME=witcher3_rag
VECTOR_DIM=1024

# --- Модели эмбеддингов и реранкера ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large

# --- LLM Сервер (OpenAI-совместимый: vLLM, Ollama, LM Studio, OpenAI) ---
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=dummy-key
LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# --- Параметры RAG поиска ---
TOP_K=4
FETCH_K=20
HNSW_EF=200
CHUNK_MAX_CHARS=2000
CHUNK_OVERLAP=100

# --- Данные и парсинг Вики ---
DATA_FILE=witcher3_knowledge_base.json
WIKI_DOMAIN=vedmak.fandom.com
ROOT_CATEGORY=Категория:Ведьмак 3
SCRAPER_DELAY=0.5
